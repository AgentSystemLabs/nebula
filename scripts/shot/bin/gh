#!/usr/bin/env python3
"""A stand-in `gh` for the SCREENSHOT HARNESS: answers the four calls nebula's GIT POLL and PR PREVIEW
make from canned JSON under $NEBULA_GH_FIXTURES, so a screenshot never needs a network, a token or a
real repository. Anything else is "couldn't ask" (exit 1) — exactly what nebula treats as no PR.

  gh api graphql … pullRequests …         → fixtures/pr-list.json, rows in `gh pr list --json` shape, handed back as
                                            the open list's GraphQL answer (a row's `statusCheckRollup` checks
                                            become the rollup `state` on its last commit). With
                                            fixtures/pr-list.ok-count holding N, only the first N calls answer and
                                            every later one fails the way GitHub's 504 did in #106.
  gh pr view --json …                     → fixtures/pr-view-<cwd basename>.json, else exit 1 (no PR on this branch)
  gh pr view <n> --json …                 → fixtures/pr-<n>.json, else exit 1
  gh pr diff <n>                          → fixtures/pr-<n>.diff, else exit 1
  gh api user --jq .login                 → fixtures/user (a login on one line), else "shot-user"
  gh issue list --state open … --json …   → fixtures/issue-list.json
  gh issue view <n> --json …              → fixtures/issue-<n>.json, else exit 1
"""
import json
import os
import sys

FIX = os.environ.get("NEBULA_GH_FIXTURES") or os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "fixtures")


def emit(name):
    path = os.path.join(FIX, name)
    if not os.path.isfile(path):
        sys.exit(1)
    sys.stdout.write(open(path).read())
    return 0


PASSING = {"SUCCESS", "NEUTRAL", "SKIPPED"}
FAILING = {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"}


def rollup(checks):
    """GitHub's one word for a commit's checks, from a `gh pr list` row's `statusCheckRollup`."""
    if not checks:
        return None
    words = [c["state"] if "state" in c else c.get("conclusion") if c.get("status") == "COMPLETED" else c.get("status")
             for c in checks]
    if any(w in FAILING for w in words):
        return {"state": "FAILURE"}
    if all(w in PASSING for w in words):
        return {"state": "SUCCESS"}
    return {"state": "PENDING"}


def open_list():
    ok = os.path.join(FIX, "pr-list.ok-count")
    if os.path.isfile(ok):
        calls = os.path.join(FIX, ".pr-list-calls")
        n = int(open(calls).read() or 0) if os.path.isfile(calls) else 0
        open(calls, "w").write(str(n + 1))
        if n >= int(open(ok).read().strip() or 0):
            sys.stderr.write("HTTP 504: We couldn't respond to your request in time. (https://api.github.com/graphql)\n")
            return 1
    path = os.path.join(FIX, "pr-list.json")
    if not os.path.isfile(path):
        return 1
    nodes = []
    for row in json.load(open(path)):
        checks = row.pop("statusCheckRollup", None)
        row["commits"] = {"nodes": [{"commit": {"statusCheckRollup": rollup(checks)}}]}
        nodes.append(row)
    json.dump({"data": {"repository": {"pullRequests": {"nodes": nodes}}}}, sys.stdout)
    return 0


def main(argv):
    if argv[:2] == ["api", "graphql"] and any("pullRequests" in a for a in argv):
        return open_list()
    if argv[:2] == ["pr", "view"]:
        rest = [a for a in argv[2:] if not a.startswith("--")]
        number = next((a for a in rest if a.isdigit()), None)
        if number:
            return emit("pr-%s.json" % number)
        return emit("pr-view-%s.json" % os.path.basename(os.getcwd()))
    if argv[:2] == ["pr", "diff"]:
        number = next((a for a in argv[2:] if a.isdigit()), None)
        return emit("pr-%s.diff" % number) if number else 1
    if argv[:2] == ["issue", "list"]:
        return emit("issue-list.json")
    if argv[:2] == ["issue", "view"]:
        number = next((a for a in argv[2:] if a.isdigit()), None)
        return emit("issue-%s.json" % number) if number else 1
    if argv[:2] == ["api", "user"]:
        path = os.path.join(FIX, "user")
        print(open(path).read().strip() if os.path.isfile(path) else "shot-user")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
